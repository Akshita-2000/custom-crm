<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_crm_lead_import_history_tree" model="ir.ui.view">
            <field name="name">crm.lead.import.history.tree</field>
            <field name="model">crm.lead.import.history</field>
            <field name="arch" type="xml">
                <tree string="Import History" export_xlsx="0">
                    <field name="name"/>
                    <field name="import_date"/>
                    <field name="user_id"/>
                    <field name="total_leads"/>
                    <field name="imported_count"/>
                    <field name="duplicates_count"/>
                    <field name="skipped_count"/>
                </tree>
            </field>
        </record>

        <record id="view_crm_lead_import_history_form" model="ir.ui.view">
            <field name="name">crm.lead.import.history.form</field>
            <field name="model">crm.lead.import.history</field>
            <field name="arch" type="xml">
                <form string="Import History Entry">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="import_date" readonly="1"/>
                                <field name="user_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="total_leads" readonly="1"/>
                                <field name="imported_count" readonly="1"/>
                                <field name="duplicates_count" readonly="1"/>
                                <field name="skipped_count" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Allocation Summary text">
                                <field name="assignment_summary" readonly="1"/>
                            </page>
                            <page string="Allocation Breakdown Matrix">
                                <field name="line_ids" readonly="1">
                                    <tree export_xlsx="0">
                                        <field name="user_id" string="Salesperson"/>
                                        <field name="allocated_count" string="Allocated Lead Count"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_crm_lead_import_history" model="ir.actions.act_window">
            <field name="name">Import History</field>
            <field name="res_model">crm.lead.import.history</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
