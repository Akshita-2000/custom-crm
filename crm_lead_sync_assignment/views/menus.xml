<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Standalone Top-Level App Menu: Custom CRM -->
        <menuitem id="menu_custom_crm_root"
                  name="Custom CRM"
                  web_icon="crm_lead_sync_assignment,static/description/icon.png"
                  sequence="10"/>

        <!-- Menu Item 1: Leads Pipeline -->
        <menuitem id="menu_custom_crm_lead_pipeline"
                  name="Leads Pipeline"
                  parent="menu_custom_crm_root"
                  action="action_custom_crm_lead"
                  sequence="10"/>

        <!-- Submenu Header 2: Lead Synchronization -->
        <menuitem id="menu_crm_lead_sync_root"
                  name="Lead Synchronization"
                  parent="menu_custom_crm_root"
                  sequence="20"/>

        <!-- Master Leads -->
        <menuitem id="menu_crm_master_lead"
                  name="Master Leads"
                  parent="menu_crm_lead_sync_root"
                  action="action_crm_master_lead"
                  sequence="10"/>

        <!-- Import Leads (Wizard Action) -->
        <menuitem id="menu_crm_lead_import_wizard"
                  name="Import Leads"
                  parent="menu_crm_lead_sync_root"
                  action="action_crm_lead_import_wizard"
                  sequence="20"/>

        <!-- Import History -->
        <menuitem id="menu_crm_lead_import_history"
                  name="Import History"
                  parent="menu_crm_lead_sync_root"
                  action="action_crm_lead_import_history"
                  sequence="30"/>

        <!-- Google Sheet Settings -->
        <menuitem id="menu_google_sheet_settings"
                  name="Google Sheet Settings"
                  parent="menu_crm_lead_sync_root"
                  action="action_crm_lead_sync_config_settings"
                  sequence="40"/>

        <!-- Sync Logs -->
        <menuitem id="menu_crm_lead_sync_log"
                  name="Sync Logs"
                  parent="menu_crm_lead_sync_root"
                  action="action_crm_lead_sync_log"
                  sequence="50"/>
    </data>
</odoo>
