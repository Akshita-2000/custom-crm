<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_crm_lead_sync_log_tree" model="ir.ui.view">
            <field name="name">crm.lead.sync.log.tree</field>
            <field name="model">crm.lead.sync.log</field>
            <field name="arch" type="xml">
                <tree string="Sync Logs" decoration-success="status == 'success'" decoration-warning="status == 'warning'" decoration-danger="status == 'failed'">
                    <field name="name"/>
                    <field name="sync_date"/>
                    <field name="triggered_by"/>
                    <field name="sheet1_records"/>
                    <field name="sheet2_records"/>
                    <field name="duplicates_found"/>
                    <field name="inserted_records"/>
                    <field name="status" widget="badge" decoration-success="status == 'success'" decoration-warning="status == 'warning'" decoration-danger="status == 'failed'"/>
                </tree>
            </field>
        </record>

        <record id="view_crm_lead_sync_log_form" model="ir.ui.view">
            <field name="name">crm.lead.sync.log.form</field>
            <field name="model">crm.lead.sync.log</field>
            <field name="arch" type="xml">
                <form string="Sync Log Entry">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="sync_date" readonly="1"/>
                                <field name="triggered_by" readonly="1"/>
                                <field name="status" widget="badge" readonly="1"/>
                            </group>
                            <group>
                                <field name="sheet1_records" readonly="1"/>
                                <field name="sheet2_records" readonly="1"/>
                                <field name="duplicates_found" readonly="1"/>
                                <field name="inserted_records" readonly="1"/>
                            </group>
                        </group>
                        <separator string="Execution Log Details"/>
                        <field name="log_details" readonly="1" widget="ace"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_crm_lead_sync_log" model="ir.actions.act_window">
            <field name="name">Synchronization Logs</field>
            <field name="res_model">crm.lead.sync.log</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
