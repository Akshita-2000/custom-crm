<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_crm_lead_import_wizard_form" model="ir.ui.view">
            <field name="name">crm.lead.import.wizard.form</field>
            <field name="model">crm.lead.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import &amp; Auto Assign Leads">
                    <sheet>
                        <div class="oe_title">
                            <h2>Distribute Master Leads to CRM Salespeople</h2>
                            <p class="text-muted">Enter the exact lead count allocation for each active salesperson before importing into Custom CRM.</p>
                        </div>
                        <group>
                            <group>
                                <field name="total_unimported_leads" string="Total Available Unimported Leads" class="fw-bold fs-4 text-primary"/>
                            </group>
                            <group>
                                <field name="total_assigned_count" string="Total Allocated Leads" class="fw-bold fs-4 text-success"/>
                            </group>
                        </group>
                        
                        <separator string="EMPLOYEE LEAD ALLOCATION MATRIX"/>
                        <field name="line_ids" mode="tree">
                            <tree editable="bottom" create="true" delete="true">
                                <field name="employee_id" string="Employee / Salesperson" options="{'no_create': True}"/>
                                <field name="allocated_count" string="Lead Count" sum="Total Assigned"/>
                            </tree>
                        </field>
                    </sheet>
                    <footer>
                        <button name="action_import_and_assign_leads" string="Import &amp; Assign Leads" type="object" class="btn-primary" icon="fa-download"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_crm_lead_import_wizard" model="ir.actions.act_window">
            <field name="name">Import &amp; Assign Leads</field>
            <field name="res_model">crm.lead.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
