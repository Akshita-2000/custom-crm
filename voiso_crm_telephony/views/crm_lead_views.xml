<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crm_lead_view_form_voiso" model="ir.ui.view">
            <field name="name">crm.lead.form.inherit.voiso</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_voiso_call_phone" 
                            string="Call Customer (Voiso)" 
                            type="object" 
                            class="btn-primary" 
                            icon="fa-phone" 
                            invisible="not phone"/>
                </xpath>

                <xpath expr="//field[@name='phone']" position="after">
                    <button name="action_voiso_call_phone"
                            type="object"
                            title="Call via Voiso"
                            icon="fa-phone"
                            class="btn btn-sm btn-outline-primary ms-1"
                            invisible="not phone"/>
                </xpath>

                <xpath expr="//field[@name='mobile']" position="after">
                    <button name="action_voiso_call_mobile"
                            type="object"
                            title="Call via Voiso"
                            icon="fa-mobile"
                            class="btn btn-sm btn-outline-primary ms-1"
                            invisible="not mobile"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
